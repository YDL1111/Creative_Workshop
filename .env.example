APP_NAME=Creative Workshop
APP_ENV=development
APP_DEBUG=true

# Fill this with your local MySQL account before first run.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/creative_workshop?charset=utf8mb4

# Docker Compose uses these values to create the MySQL container.
MYSQL_ROOT_PASSWORD=change_me_for_docker
MYSQL_DATABASE=creative_workshop
MYSQL_PORT=3306
APP_PORT=8000

# Keep mock for the first run. Switch when your cloud image API is ready.
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=

# For OpenAI-compatible image APIs, set IMAGE_PROVIDER=openai_compatible.
# The service sends POST {IMAGE_API_BASE_URL}/images/generations.


# Prompt optimization LLM, OpenAI-compatible chat completions endpoint.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.example.com/v1
LLM_MODEL=

